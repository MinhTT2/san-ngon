# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chỉ dùng cho Supabase CLI/MCP, không phải secret.
SUPABASE_PROJECT_REF=

# SePay — giữ webhook cũ để đối soát các đơn trước khi chuyển sang OAuth.
# Chỉ dùng phía server
SEPAY_WEBHOOK_API_KEY=

# SePay OAuth — chỉ server, ứng dụng đã được duyệt trong ticket #6725.
SEPAY_OAUTH_CLIENT_ID=
SEPAY_OAUTH_CLIENT_SECRET=
SEPAY_OAUTH_REDIRECT_URI=https://san-ngon.vercel.app/api/sepay/callback
# Khóa AES 256-bit: 64 ký tự hex ngẫu nhiên; sao lưu riêng, không đổi tùy ý.
SEPAY_TOKEN_ENCRYPTION_KEY=

# SePay — tài khoản cũ, dùng khởi tạo snapshot trong SQL
NEXT_PUBLIC_SEPAY_ACCOUNT=
# Phải khớp trường gateway SePay gửi, ví dụ MBBank (không dùng MB).
NEXT_PUBLIC_SEPAY_BANK=MBBank
NEXT_PUBLIC_SEPAY_ACCOUNT_NAME=

# Telegram — kênh báo đơn mới cho chủ sân
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Email báo đơn cho chủ sân — tuỳ chọn, dùng Resend
RESEND_API_KEY=
EMAIL_FROM=San Ngon <no-reply@example.com>

# Dùng dựng link quay về sau khi đăng nhập. Bỏ trống thì lấy origin của trình
# duyệt — tiện cho bản preview Vercel, nhưng production nên điền đúng domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
